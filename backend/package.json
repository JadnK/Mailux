{
  "name": "mailux-backend",
  "version": "1.0.0",
  "description": "Mailux backend - Node.js + TypeScript + Express API for PAM-authenticated Postfix/Dovecot mail management.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "authenticate-pam": "1.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.13.0"
  }
}
