# Copy this file to .env (or provide these via systemd's EnvironmentFile,
# see deploy/mailux-backend.env.example) and fill in your mail server details.

NODE_ENV=production
PORT=5000

# Comma-separated list of allowed frontend origins, or "*" for any.
CORS_ORIGIN=http://localhost:5173

# Domain used to build "user@<MAIL_DOMAIN>" addresses.
MAIL_DOMAIN=example.com

# SMTP (Postfix submission)
MAIL_HOST=mail.example.com
MAIL_PORT=587

# IMAP (Dovecot)
MAIL_HOST_IMAP=mail.example.com
MAIL_IMAP_PORT=993

# How long a login session stays valid, in hours (default: 720 = 30 days).
# Sessions live in memory only and do not survive a backend restart.
SESSION_TTL_HOURS=720

# Lowest UID treated as a mail user when scanning /etc/passwd.
MAILUX_MIN_UID=1000

# Base directory new mailboxes are created under.
MAILUX_MAIL_BASE_DIR=/mailuser

# Must match the installed /etc/pam.d/<name> service file (see backend/pam/mailux).
MAILUX_PAM_SERVICE=mailux
