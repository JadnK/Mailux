# Copy to /etc/mailux/backend.env (root-owned, chmod 600) and fill in.
# Referenced by deploy/systemd/mailux-backend.service via EnvironmentFile=.
# This is the same set of variables as backend/.env.example.

NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://mail.example.com

MAIL_DOMAIN=example.com

MAIL_HOST=mail.example.com
MAIL_PORT=587

MAIL_HOST_IMAP=mail.example.com
MAIL_IMAP_PORT=993

SESSION_TTL_HOURS=720
MAILUX_MIN_UID=1000
MAILUX_MAIL_BASE_DIR=/mailuser
MAILUX_PAM_SERVICE=mailux
